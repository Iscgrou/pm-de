#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/xauusd-agy-advisor"
CACHE_DIR="${APP_DIR}/cache"
STORAGE_DIR="${APP_DIR}/storage"

echo "[xauusd-aurum-deck] Post-installation setup starting..."
mkdir -p "${CACHE_DIR}" "${STORAGE_DIR}"

if [ ! -d "${APP_DIR}/.venv" ]; then
  echo "[xauusd-aurum-deck] Creating Python virtual environment..."
  python3 -m venv "${APP_DIR}/.venv"
fi

echo "[xauusd-aurum-deck] Installing Python dependencies..."
"${APP_DIR}/.venv/bin/pip" install --quiet --upgrade pip
"${APP_DIR}/.venv/bin/pip" install --quiet -r "${APP_DIR}/requirements.txt"

echo "[xauusd-aurum-deck] Initializing SQLite WAL database schema..."
sqlite3 "${STORAGE_DIR}/trading.db" < "${STORAGE_DIR}/schema.sql"

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl enable xauusd-sentinel.service || true
  systemctl restart xauusd-sentinel.service || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications || true
fi

echo "[xauusd-aurum-deck] Installation complete. Open http://127.0.0.1:8787 or run 'xauusd-aurum-deck'."
exit 0
