#!/usr/bin/env bash
set -euo pipefail

URL="http://127.0.0.1:8787"
APP_DIR="/opt/xauusd-agy-advisor"

case "${1:-open}" in
  open)
    if ! curl -sf "${URL}/api/v1/health" >/dev/null 2>&1; then
      if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q xauusd-sentinel.service; then
        sudo systemctl start xauusd-sentinel.service || true
        sleep 1.5
      else
        nohup "${APP_DIR}/.venv/bin/uvicorn" sentinel_app.server:app --host 127.0.0.1 --port 8787 \
          >> "${APP_DIR}/cache/sentinel_server.log" 2>&1 &
        sleep 1.5
      fi
    fi
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "${URL}" >/dev/null 2>&1 &
    else
      echo "Aurum Command Deck running at ${URL}"
    fi
    ;;
  verify)
    cd "${APP_DIR}" && "${APP_DIR}/.venv/bin/python3" self_verify_10gates.py
    ;;
  test)
    cd "${APP_DIR}" && "${APP_DIR}/.venv/bin/pytest" -v
    ;;
  health)
    curl -s "${URL}/api/v1/health" | jq .
    ;;
  logs)
    tail -f "${APP_DIR}/cache/sentinel_server.log"
    ;;
  mcp)
    cd "${APP_DIR}" && exec "${APP_DIR}/.venv/bin/python3" mcp_server/xau_native_smc_mcp.py
    ;;
  *)
    echo "Usage: xauusd-aurum-deck {open|verify|test|health|logs|mcp}"
    exit 1
    ;;
esac
