#!/usr/bin/env bash
set -euo pipefail

PORT="${PORT:-3000}"
URL="http://127.0.0.1:${PORT}"
APP_DIR="/opt/xauusd-aurum-deck"
MCP_SCRIPT="/opt/xauusd-agy-advisor/mcp_server/xau_native_smc_mcp.py"
LOG_FILE="${APP_DIR}/logs/aurum-deck.log"

case "${1:-open}" in
  open)
    if ! curl -sf "${URL}/api/v1/health" >/dev/null 2>&1; then
      if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q xauusd-aurum-deck.service; then
        sudo systemctl start xauusd-aurum-deck.service || true
        sleep 1.5
      elif [ -f "${APP_DIR}/server.ts" ]; then
        mkdir -p "${APP_DIR}/logs"
        nohup env NODE_ENV=production PORT="${PORT}" DISABLE_HMR=true npx --prefix "${APP_DIR}" tsx "${APP_DIR}/server.ts" \
          >> "${LOG_FILE}" 2>&1 &
        sleep 2.0
      fi
    fi
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "${URL}" >/dev/null 2>&1 &
    else
      echo "Payam XAUUSD Aurum Command Deck running at ${URL}"
    fi
    ;;
  status)
    systemctl status xauusd-aurum-deck.service --no-pager || true
    ;;
  restart)
    sudo systemctl restart xauusd-aurum-deck.service
    ;;
  health)
    curl -s "${URL}/api/v1/health" | jq .
    ;;
  logs)
    tail -f "${LOG_FILE}"
    ;;
  oauth)
    shift || true
    exec /usr/bin/xauusd-ai-oauth-bridge "${@:-status}"
    ;;
  mcp)
    export XAUUSD_DECK_URL="${URL}"
    exec python3 "${MCP_SCRIPT}"
    ;;
  *)
    echo "Usage: xauusd-aurum-deck {open|status|restart|health|logs|oauth [login|start-proxy|status|test]|mcp}"
    exit 1
    ;;
esac
